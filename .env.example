# ─────────────────────────────────────────────────────────────────────────
# InsightIQ — environment configuration
# Copy this file to ".env" and fill in your keys.
#
# These variables are read by Vite at BUILD time and embedded into the
# client bundle as import.meta.env.VITE_*. They are NOT secret in a
# frontend-only app — they are organisational and keep keys out of source
# control. For production-grade secrecy you would proxy through a backend.
# ─────────────────────────────────────────────────────────────────────────

# Primary intelligence provider (fast, generous free tier)
VITE_GROQ_API_KEY=
VITE_GROQ_API_KEY_2=
# Secondary intelligence provider (fallback when the primary is rate-limited)
VITE_OPENROUTER_API_KEY=

# Optional: override the default generation model ids.
# Leave blank to use the curated defaults in src/config/providers.js
VITE_GROQ_MODEL=
VITE_OPENROUTER_MODEL=
